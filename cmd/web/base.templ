package web

templ Base() {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<title>Illuminate - Photometric Data Converter</title>
			<link href="/assets/css/output.css" rel="stylesheet"/>
		<script src="/assets/js/htmx.min.js"></script>
		<script>
			document.addEventListener('htmx:configRequest', function(evt) {
				document.getElementById('convert-btn').disabled = true;
			});
			document.addEventListener('htmx:afterRequest', function(evt) {
				document.getElementById('convert-btn').disabled = false;
			});

			let lastConvertedData = null;
			let lastConvertedFilename = '';

			async function submitConvertForm(event) {
				event.preventDefault();
				const form = document.getElementById('convert-form');
				const fileInput = document.getElementById('file-input');
				const resultDiv = document.getElementById('converter-result');
				const btn = document.getElementById('convert-btn');
				const loadingIndicator = document.getElementById('loading-indicator');
				
				if (!fileInput.files.length) {
					return;
				}

				btn.disabled = true;
				loadingIndicator.classList.remove('hidden');
				resultDiv.innerHTML = '';

				const formData = new FormData();
				formData.append('file', fileInput.files[0]);

				try {
					const response = await fetch('/api/v1/convert', {
						method: 'POST',
						body: formData
					});

					const json = await response.json();

					if (json.success && json.data) {
						lastConvertedData = json.data;
						lastConvertedFilename = json.filename;
						resultDiv.innerHTML = `
							<div class="bg-accent/10 border border-accent/30 rounded-lg p-6 text-center">
								<div class="w-12 h-12 bg-accent/20 rounded-full flex items-center justify-center mx-auto mb-3">
									<svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
									</svg>
								</div>
								<p class="text-accent font-semibold text-lg mb-1">Conversion Successful!</p>
								<p class="text-gray-400 text-sm mb-4">${json.filename}</p>
								<button onclick="triggerDownload()" class="bg-accent hover:bg-accent-hover text-white font-semibold py-2 px-6 rounded-lg transition-colors inline-flex items-center cursor-pointer">
									<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
									</svg>
									Download CIE File
								</button>
							</div>
						`;
					} else {
						resultDiv.innerHTML = `
							<div class="bg-red-500/10 border border-red-500/30 rounded-lg p-6 text-center">
								<div class="w-12 h-12 bg-red-500/20 rounded-full flex items-center justify-center mx-auto mb-3">
									<svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
									</svg>
								</div>
								<p class="text-red-400 font-semibold text-lg mb-1">Conversion Failed</p>
								<p class="text-gray-400 text-sm">${json.error}</p>
							</div>
						`;
					}
				} catch (err) {
					resultDiv.innerHTML = `
						<div class="bg-red-500/10 border border-red-500/30 rounded-lg p-6 text-center">
							<div class="w-12 h-12 bg-red-500/20 rounded-full flex items-center justify-center mx-auto mb-3">
								<svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
								</svg>
							</div>
							<p class="text-red-400 font-semibold text-lg mb-1">Conversion Failed</p>
							<p class="text-gray-400 text-sm">An error occurred. Please try again.</p>
						</div>
					`;
				} finally {
					btn.disabled = false;
					loadingIndicator.classList.add('hidden');
				}
			}

			function triggerDownload() {
				if (lastConvertedData && lastConvertedFilename) {
					const binaryString = atob(lastConvertedData);
					const bytes = new Uint8Array(binaryString.length);
					for (let i = 0; i < binaryString.length; i++) {
						bytes[i] = binaryString.charCodeAt(i);
					}
					const blob = new Blob([bytes], { type: 'application/octet-stream' });
					const url = window.URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url;
					a.download = lastConvertedFilename;
					document.body.appendChild(a);
					a.click();
					window.URL.revokeObjectURL(url);
					document.body.removeChild(a);
				}
			}
		</script>
		<script>
			function toggleDarkMode() {
				const html = document.documentElement;
				html.classList.toggle('dark');
				const isDark = html.classList.contains('dark');
				localStorage.setItem('darkMode', isDark ? 'dark' : 'light');
			}
			document.addEventListener('DOMContentLoaded', () => {
				const saved = localStorage.getItem('darkMode');
				if (saved === 'light') {
					document.documentElement.classList.remove('dark');
				}
			});

			let lastConvertedData = null;
			let lastConvertedFilename = '';

			function handleConvertResponse(event) {
				const target = event.target;
				if (target.status === 200) {
					try {
						const json = JSON.parse(target.response);
						if (json.success && json.data) {
							lastConvertedData = json.data;
							lastConvertedFilename = json.filename;
							const resultDiv = document.getElementById('converter-result');
							resultDiv.innerHTML = `
								<div class="bg-accent/10 border border-accent/30 rounded-lg p-6 text-center">
									<div class="w-12 h-12 bg-accent/20 rounded-full flex items-center justify-center mx-auto mb-3">
										<svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
										</svg>
									</div>
									<p class="text-accent font-semibold text-lg mb-1">Conversion Successful!</p>
									<p class="text-gray-400 text-sm mb-4">${json.filename}</p>
									<button onclick="triggerDownload()" class="bg-accent hover:bg-accent-hover text-white font-semibold py-2 px-6 rounded-lg transition-colors inline-flex items-center cursor-pointer">
										<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
										</svg>
										Download CIE File
									</button>
								</div>
							`;
						} else if (!json.success) {
							const resultDiv = document.getElementById('converter-result');
							resultDiv.innerHTML = `
								<div class="bg-red-500/10 border border-red-500/30 rounded-lg p-6 text-center">
									<div class="w-12 h-12 bg-red-500/20 rounded-full flex items-center justify-center mx-auto mb-3">
										<svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
										</svg>
									</div>
									<p class="text-red-400 font-semibold text-lg mb-1">Conversion Failed</p>
									<p class="text-gray-400 text-sm">${json.error}</p>
								</div>
							`;
						}
					} catch (e) {
						console.error('Failed to parse response:', e);
					}
				}
				document.getElementById('convert-btn').disabled = false;
			}

			function triggerDownload() {
				if (lastConvertedData && lastConvertedFilename) {
					const binaryString = atob(lastConvertedData);
					const bytes = new Uint8Array(binaryString.length);
					for (let i = 0; i < binaryString.length; i++) {
						bytes[i] = binaryString.charCodeAt(i);
					}
					const blob = new Blob([bytes], { type: 'application/octet-stream' });
					const url = window.URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url;
					a.download = lastConvertedFilename;
					document.body.appendChild(a);
					a.click();
					window.URL.revokeObjectURL(url);
					document.body.removeChild(a);
				}
			}
		</script>
		</head>
		<body class="bg-dark-900 text-gray-100 min-h-screen dark:bg-gray-100 dark:text-gray-900">
			<nav class="bg-dark-800 border-b border-dark-600 dark:bg-white dark:border-gray-200">
				<div class="max-w-7xl mx-auto px-4">
					<div class="flex justify-between items-center h-16">
						<div class="flex items-center space-x-8">
							<a href="/" class="text-xl font-bold text-primary dark:text-orange-600">Illuminate</a>
						</div>
						<div class="flex items-center space-x-4">
							<button 
								onclick="toggleDarkMode()"
								class="p-2 rounded-lg hover:bg-dark-700 dark:hover:bg-gray-200 transition-colors"
								aria-label="Toggle dark mode"
							>
								<svg class="w-5 h-5 text-gray-300 dark:text-gray-700 hidden dark:block" fill="currentColor" viewBox="0 0 20 20">
									<path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/>
								</svg>
								<svg class="w-5 h-5 text-gray-700 dark:hidden block" fill="currentColor" viewBox="0 0 20 20">
									<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
								</svg>
							</button>
							<a href="/login" class="text-gray-300 hover:text-primary transition-colors dark:text-gray-700 dark:hover:text-orange-600">Login</a>
							<a href="/register" class="bg-primary hover:bg-primary-hover text-white px-4 py-2 rounded-lg transition-colors dark:bg-orange-600 dark:hover:bg-orange-700">Sign Up</a>
						</div>
					</div>
				</div>
			</nav>
			<main class="min-h-[calc(100vh-4rem)] dark:bg-gray-100">
				{ children... }
			</main>
		</body>
	</html>
}
