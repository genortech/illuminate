package web

type ConversionResult struct {
	Success   bool   `json:"success"`
	Message   string `json:"message"`
	OutputURL string `json:"output_url,omitempty"`
}

templ Landing() {
	@Base() {
		<section class="relative overflow-hidden hero-bg">
			<div class="absolute inset-0 bg-gradient-to-br from-dark-900 via-dark-800 to-dark-900"></div>
			<div class="absolute inset-0 opacity-30">
				<div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/20 rounded-full blur-3xl"></div>
				<div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-accent/20 rounded-full blur-3xl"></div>
			</div>
			
			<div class="relative max-w-7xl mx-auto px-4 py-24">
				<div class="text-center mb-16">
					<h1 class="text-5xl md:text-6xl font-bold mb-6">
						<span class="text-white">Convert </span>
						<span class="text-primary">IES</span>
						<span class="text-gray-500"> to </span>
						<span class="text-accent">CIE</span>
					</h1>
					<p class="text-xl text-gray-400 max-w-2xl mx-auto">
						Professional photometric data converter for lighting engineers. 
						Fast, accurate, and compliant with Australian standards.
					</p>
				</div>

				<div class="max-w-2xl mx-auto">
					<div class="bg-dark-800 border border-dark-600 rounded-2xl p-8 shadow-2xl">
						<form 
							hx-post="/api/v1/convert" 
							hx-target="#converter-result"
							hx-swap="innerHTML"
							enctype="multipart/form-data"
							class="space-y-6"
						>
							<div>
								<label class="block text-sm font-medium text-gray-300 mb-2">
									Upload IES File
								</label>
								<div class="relative">
									<input 
										type="file" 
										name="file" 
										accept=".ies"
										required
										class="block w-full text-sm text-gray-300
											file:mr-4 file:py-2 file:px-4
											file:rounded-lg file:border-0
											file:text-sm file:font-semibold
											file:bg-primary/10 file:text-primary
											hover:file:bg-primary/20
											file:transition-colors
											bg-dark-700 border border-dark-600 rounded-lg
											file:cursor-pointer file:mr-4
											placeholder-gray-500"
									/>
								</div>
								<p class="mt-2 text-xs text-gray-500">Supported format: .ies</p>
							</div>

							<button 
								type="submit"
								class="w-full bg-primary hover:bg-primary-hover text-white font-semibold py-3 px-6 rounded-lg transition-all transform hover:scale-[1.02] active:scale-[0.98]"
							>
								Convert to CIE
							</button>
						</form>

						<div id="converter-result" class="mt-6"></div>
					</div>

					<div class="mt-8 text-center">
						<p class="text-gray-500 text-sm">
							<a href="/register" class="text-primary hover:underline">Sign up</a> to save luminaires and conversions
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="bg-dark-800 border-t border-dark-600 py-16">
			<div class="max-w-7xl mx-auto px-4">
				<h2 class="text-3xl font-bold text-center mb-12">
					<span class="text-white">Why </span>
					<span class="text-primary">Illuminate</span>
				</h2>
				
				<div class="grid md:grid-cols-3 gap-8">
					<div class="bg-dark-700 border border-dark-600 rounded-xl p-6">
						<div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-2">Lightning Fast</h3>
						<p class="text-gray-400">Convert IES to CIE in seconds. No waiting, no delays.</p>
					</div>

					<div class="bg-dark-700 border border-dark-600 rounded-xl p-6">
						<div class="w-12 h-12 bg-accent/10 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-2">AS1158 Compliant</h3>
						<p class="text-gray-400">Built for Australian lighting standards. Future spacing charts coming soon.</p>
					</div>

					<div class="bg-dark-700 border border-dark-600 rounded-xl p-6">
						<div class="w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center mb-4">
							<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-2">Secure Storage</h3>
						<p class="text-gray-400">Save your conversions. Access them anytime from any device.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="py-16 border-t border-dark-600">
			<div class="max-w-7xl mx-auto px-4 text-center">
				<p class="text-gray-500">
					<span class="text-primary">Illuminate</span> — Professional photometric data tools for lighting engineers
				</p>
			</div>
		</section>
	}
}

templ ConversionSuccess(filename, downloadURL string) {
	<div class="bg-accent/10 border border-accent/30 rounded-lg p-4 flex items-center justify-between">
		<div>
			<p class="text-accent font-medium">Conversion successful!</p>
			<p class="text-sm text-gray-400">{filename}</p>
		</div>
		<a 
			href={templ.URL(downloadURL)} 
			class="bg-accent hover:bg-accent-hover text-white px-4 py-2 rounded-lg transition-colors"
		>
			Download CIE
		</a>
	</div>
}

templ ConversionError(message string) {
	<div class="bg-red-500/10 border border-red-500/30 rounded-lg p-4">
		<p class="text-red-400 font-medium">Conversion failed</p>
		<p class="text-sm text-gray-400">{message}</p>
	</div>
}

templ ConversionLoading() {
	<div class="flex items-center justify-center p-4">
		<div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
		<span class="ml-3 text-gray-400">Converting...</span>
	</div>
}
